{
  "name": "mgrm-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "routes": [
    { "pattern": "hub.mgrm.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mgrm-hub", "database_id": "dd20c8eb-a9e3-47d5-abc9-a33a4236a04a" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
